# Reproducible, security-conscious installs
save-exact=true
engine-strict=true
# eslint-plugin-vue lists optional stylistic peers we don't use; don't fail install on them
strict-peer-dependencies=false
# Do not run arbitrary dependency lifecycle scripts on install (supply-chain hardening).
# Add specific trusted packages here if a build genuinely needs a postinstall.
enable-pre-post-scripts=false
