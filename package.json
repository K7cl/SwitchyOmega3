{
  "name": "switchyomega-monorepo",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @switchyomega/extension dev",
    "build:locales": "node packages/omega-i18n/src/build_locales.ts",
    "build": "pnpm build:locales && pnpm --filter @switchyomega/extension build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "package": "pnpm build && node scripts/check-bundle.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.7",
    "vitest": "4.1.10"
  }
}
